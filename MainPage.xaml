<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkDays.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="Work Shift Booking Tool" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Date Selection -->
            <Label Text="Select Date" 
                   FontSize="16" 
                   FontAttributes="Bold" />
            <DatePicker x:Name="ShiftDatePicker" 
                        Format="D" 
                        MinimumDate="2026-01-01" />

            <!-- Start Time Selection -->
            <Label Text="Start Time (08:00 - 21:00)" 
                   FontSize="16" 
                   FontAttributes="Bold" />
            <Picker x:Name="StartTimePicker" 
                    Title="Select start time" />

            <!-- End Time Selection -->
            <Label Text="End Time" 
                   FontSize="16" 
                   FontAttributes="Bold" />
            <Picker x:Name="EndTimePicker" 
                    Title="Select end time" />

            <!-- Calendar Selection -->
            <Label Text="Select Calendar" 
                   FontSize="16" 
                   FontAttributes="Bold" />
            <Picker x:Name="CalendarPicker" 
                    Title="Select calendar" />

            <Entry x:Name="CalendarEmailEntry"
                   Placeholder="Or enter calendar email"
                   Keyboard="Email"
                   Margin="0,10,0,0" />

            <!-- Booking Button -->
            <Button x:Name="BookShiftButton"
                    Text="Book Shift"
                    Clicked="OnBookShiftClicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    Margin="0,20,0,0"
                    Padding="20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
