
<VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

    <Label Text="Work Shift Booking Tool" 
           FontSize="24" 
           HorizontalOptions="Center" />

    <!-- Date Selection Input -->
    <DatePicker x:Name="ShiftDatePicker" 
                Format="D" 
                MinimumDate="2026-01-01" />

    <!-- Execution Trigger -->
    <Button x:Name="BookShiftButton"
            Text="Book Shift to Shared Calendar"
            Clicked="OnBookShiftClicked"
            BackgroundColor="#512BD4"
            TextColor="White" />

</VerticalStackLayout>
